# TerraFind Environment Configuration

PORT=8787

# Supabase (Optional: for cloud PostgreSQL & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenStreetMap Nominatim User Agent (identifies application as required by usage policy)
NOMINATIM_USER_AGENT=TerraFind/1.0 (contact@terrafind.in)

# Property Data Provider (Optional: if integrating an external licensed MLS/API)
PROPERTY_API_URL=
PROPERTY_API_KEY=
PROPERTY_API_HEADER=Authorization

# Water Quality API (Optional: if connecting state WSSO or official provider)
WATER_API_URL=
WATER_API_KEY=

# Crime & Safety Data API (Optional: if connecting live state/city police feed)
CRIME_API_URL=
CRIME_API_KEY=

# Data.gov.in Official Open Data API (Optional)
DATA_GOV_API_KEY=
CRIME_RESOURCE_ID=

# AI Investment Advisor (Optional: Google Gemini Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
